# Copy this file to .env.local (or .env for Docker Compose) and fill in real values.
# Never commit the filled-in file — .gitignore already excludes .env*.

# Resend (contact / journey / job application emails)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=support@techlynk.co
RESEND_TO_EMAIL=support@techlynk.co

# Shown by /api/mail-info
CONTACT_PHONE=+91 95737 87824
CONTACT_LOCATION=Hyderabad, India

# Canonical URL for SEO
NEXT_PUBLIC_SITE_URL=https://techlynk.co

# Admin panel (/admin) — lets you toggle job openings on/off and edit them
# without a code deploy. Required for /admin to work at all; pick a strong
# value, it's the only thing gating write access to the site's job listings.
ADMIN_PASSWORD=change-me

# Where job listings are stored. In production this MUST point outside the
# deployed code directory (e.g. /opt/techlynk-data/jobs.json) — a deploy
# replaces the whole app directory, and a file left under it would be wiped
# on the next deploy. Defaults to ./data/jobs.json, which is fine for local dev.
JOBS_DATA_FILE=/opt/techlynk-data/jobs.json
